{
  "id": "basic-theory",
  "order": 1,
  "title": "基礎理論",
  "description": "サンプル: 2進数と論理演算",
  "color": "green",
  "lessons": [
    {
      "id": "binary-basics",
      "title": "2進数のきほん",
      "questions": [
        {
          "type": "choice",
          "prompt": "2進数の 1010 を10進数で表すと？",
          "choices": [
            "8",
            "10",
            "12",
            "14"
          ],
          "answer": "10",
          "explanation": "8 + 2 = 10 です。"
        },
        {
          "type": "truefalse",
          "prompt": "1バイトは8ビットである。",
          "answer": true,
          "explanation": "1バイト = 8ビットです。"
        },
        {
          "type": "choice",
          "prompt": "10進数の 13 を2進数で表すと？",
          "choices": [
            "1001",
            "1011",
            "1101",
            "1110"
          ],
          "answer": "1101",
          "explanation": "8 + 4 + 1 = 13 なので 1101 です。"
        },
        {
          "type": "order",
          "prompt": "2の補数を求める手順を順に並べよう",
          "answer": [
            "全ビットを反転する",
            "1を足す"
          ],
          "distractors": [
            "1を引く"
          ],
          "explanation": "全ビットを反転してから1を足します。"
        },
        {
          "type": "choice",
          "prompt": "16進数の 1F を10進数で表すと？",
          "choices": [
            "15",
            "16",
            "31",
            "32"
          ],
          "answer": "31",
          "explanation": "1×16 + 15 = 31 です。"
        },
        {
          "type": "choice",
          "prompt": "2進数の 11000011 を16進数で表すと？",
          "choices": [
            "C3",
            "3C",
            "B3",
            "C4"
          ],
          "answer": "C3",
          "explanation": "4ビットずつ区切ると 1100 = C、0011 = 3 なので C3 です。"
        },
        {
          "type": "truefalse",
          "prompt": "8ビットで表せる符号なし整数の最大値は 256 である。",
          "answer": false,
          "explanation": "0〜255 の 256 通りなので、最大値は 255 です。"
        },
        {
          "type": "choice",
          "prompt": "8ビットの2の補数表現で −1 を表すと？",
          "choices": [
            "10000001",
            "11111110",
            "11111111",
            "01111111"
          ],
          "answer": "11111111",
          "explanation": "00000001 を反転すると 11111110、1を足して 11111111 です。"
        },
        {
          "type": "truefalse",
          "prompt": "2進数を1ビット左にシフトすると、値は2倍になる（あふれがない場合）。",
          "answer": true,
          "explanation": "左シフトは ×2、右シフトは ÷2 に相当します。"
        },
        {
          "type": "match",
          "prompt": "表記と値を組み合わせよう",
          "pairs": [
            [
              "2進数 100",
              "10進数の 4"
            ],
            [
              "8進数 10",
              "10進数の 8"
            ],
            [
              "16進数 10",
              "10進数の 16"
            ],
            [
              "2進数 1111",
              "10進数の 15"
            ]
          ]
        }
      ]
    },
    {
      "id": "logic-operations",
      "title": "論理演算",
      "questions": [
        {
          "type": "truefalse",
          "prompt": "1 XOR 1 の結果は 1 である。",
          "answer": false,
          "explanation": "XOR は2つの入力が異なるときに 1 になるので、結果は 0 です。"
        },
        {
          "type": "choice",
          "prompt": "1 AND 0 の結果は？",
          "choices": [
            "0",
            "1"
          ],
          "answer": "0",
          "explanation": "AND は両方が 1 のときだけ 1 になります。"
        },
        {
          "type": "match",
          "prompt": "演算と説明を組み合わせよう",
          "pairs": [
            [
              "AND",
              "両方が1のとき1"
            ],
            [
              "OR",
              "少なくとも一方が1のとき1"
            ],
            [
              "XOR",
              "2つが異なるとき1"
            ],
            [
              "NOT",
              "0と1を反転する"
            ]
          ]
        },
        {
          "type": "choice",
          "prompt": "0 OR 1 の結果は？",
          "choices": [
            "0",
            "1"
          ],
          "answer": "1",
          "explanation": "OR はどちらか一方が 1 なら 1 になります。"
        },
        {
          "type": "truefalse",
          "prompt": "NOT (A AND B) は (NOT A) OR (NOT B) と等しい。",
          "answer": true,
          "explanation": "ド・モルガンの法則です。"
        },
        {
          "type": "choice",
          "prompt": "ビット列 1010 と 0110 の XOR を取ると？",
          "choices": [
            "0010",
            "1100",
            "1110",
            "0100"
          ],
          "answer": "1100",
          "explanation": "ビットごとに異なる桁が 1 になるので 1100 です。"
        },
        {
          "type": "choice",
          "prompt": "8ビットのデータの下位4ビットだけを取り出すには、どのマスクと AND を取る？",
          "choices": [
            "00001111",
            "11110000",
            "11111111",
            "00000000"
          ],
          "answer": "00001111",
          "explanation": "残したいビットを 1、消したいビットを 0 にしたマスクと AND を取ります。"
        },
        {
          "type": "truefalse",
          "prompt": "NAND は AND の結果を反転したものである。",
          "answer": true,
          "explanation": "NAND = NOT AND。両方が 1 のときだけ 0 になります。"
        }
      ]
    }
  ]
}
